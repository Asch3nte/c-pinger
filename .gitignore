# Artefacts de build PyInstaller — le dossier de travail ne va jamais dans
# le dépôt ; les binaires finaux (dist/) sont eux versionnés (voir README).
/build/

# Python
__pycache__/
*.pyc
*.pyo

# Environnements virtuels
.venv/
venv/

# Données runtime générées au lancement à côté des binaires (config perso,
# log, état, verrou mono-instance) — jamais les binaires eux-mêmes.
claudeping.log
claudeping.log.*
claudeping_state*.json
claudeping.lock
/dist/*/config.yaml
